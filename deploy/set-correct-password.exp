#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 使用 Python 生成的正确 BCrypt 哈希（将 $2b$ 改为 $2a$ 以兼容 Spring Security）
send "mysql -u root -p'root' trace_system << 'SQLEOF'\nUPDATE enterprise SET login_password_hash='\$2a\$10\$MKCpT2hj0K/1j4.8WKliXufYyCP/97.Wy0UURoJXiDUnjlZ9mVYja' WHERE login_account='admin';\nSQLEOF\n\r"
expect "#"

# 验证
send "mysql -u root -p'root' trace_system -e \"SELECT login_password_hash FROM enterprise WHERE login_account='admin';\"\r"
expect "#"

# 测试登录
send "echo 'Testing login...'\r"
expect "#"
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "\necho 'Done!'\r"
expect "#"

send "exit\r"
expect eof
