#!/usr/bin/expect -f
set timeout 120
set server_ip "8.152.162.118"
set password "Rango2025="

# 使用 scp 上传 SQL 文件
spawn scp /Users/ron/Qoder/trace-system/sql/V12__test_data.sql root@$server_ip:/tmp/V12__test_data.sql
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}
expect eof

# SSH 登录服务器执行 SQL
spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 执行 SQL 文件
send "mysql -u root -p'root' < /tmp/V12__test_data.sql 2>&1\r"
expect "#"

# 查看企业列表验证
send "mysql -u root -p'root' trace_system -e \"SELECT id, login_account, name FROM enterprise;\"\r"
expect "#"

# 查看基地列表
send "mysql -u root -p'root' trace_system -e \"SELECT id, enterprise_id, name FROM enterprise_base;\"\r"
expect "#"

# 查看商品列表
send "mysql -u root -p'root' trace_system -e \"SELECT id, enterprise_id, name FROM goods;\"\r"
expect "#"

# 查看批次列表
send "mysql -u root -p'root' trace_system -e \"SELECT id, enterprise_id, name FROM batch;\"\r"
expect "#"

# 查看检测报告
send "mysql -u root -p'root' trace_system -e \"SELECT id, enterprise_id, report_name FROM test_report;\"\r"
expect "#"

# 查看订单
send "mysql -u root -p'root' trace_system -e \"SELECT id, order_no, enterprise_id, status FROM t_order;\"\r"
expect "#"

send "exit\r"
expect eof
