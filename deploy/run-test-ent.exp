#!/usr/bin/expect -f
set timeout 180

# SCP the script
spawn scp -o StrictHostKeyChecking=no /Users/ron/Qoder/trace-system/deploy/test-ent-api.sh root@8.152.162.118:/tmp/test-ent-api.sh
expect "password:"
send "Rango2025=\r"
expect eof

# Run it
spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect "password:"
send "Rango2025=\r"
expect "# "

send "bash /tmp/test-ent-api.sh 2>&1; echo SCRIPT_FINISHED\r"
expect {
    "SCRIPT_FINISHED" { }
    timeout { puts "TIMEOUT_AFTER_180s" }
}
expect "# "

send "exit\r"
expect eof
