#!/usr/bin/expect -f
set timeout 300
set server_ip "8.152.162.118"
set password "Rango2025="

puts "========================================"
puts "  修复后端服务"
puts "========================================"

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 检查 Java 版本
puts "\n[1] 检查 Java 版本..."
send "java -version 2>&1 | head -3\r"
expect "#"

# 手动构建后端
puts "\n[2] 构建后端..."
send "cd /opt/trace-system/trace-backend && mvn clean package -DskipTests 2>&1 | tail -50\r"
expect "#"

# 检查 jar 包是否生成
puts "\n[3] 检查构建结果..."
send "ls -lh target/*.jar 2>&1\r"
expect "#"

# 重启后端服务
puts "\n[4] 重启后端服务..."
send "systemctl restart trace-backend\r"
expect "#"

# 等待服务启动
send "sleep 10\r"
expect "#"

# 检查服务状态
puts "\n[5] 检查服务状态..."
send "systemctl status trace-backend --no-pager | head -20\r"
expect "#"

# 测试 API
puts "\n[6] 测试 API..."
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}' 2>&1 | head -5\r"
expect "#"

send "exit\r"
expect eof

puts "\n========================================"
puts "  ✅ 后端修复完成"
puts "========================================"
