#!/usr/bin/expect -f
set timeout 120
set server_ip "8.152.162.118"
set password "Rango2025="

# 上传测试脚本
spawn scp /Users/ron/Qoder/trace-system/deploy/test-apis.sh root@$server_ip:/tmp/test-apis.sh
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}
expect eof

# SSH 执行测试脚本
spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"
send "bash /tmp/test-apis.sh 2>&1\r"
expect {
    "=== API测试完成 ===" {}
    timeout { puts "TIMEOUT" }
}
expect "#"

send "exit\r"
expect eof
