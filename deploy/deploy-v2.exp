#!/usr/bin/expect -f
set timeout 600

# Step 1: Push to deploy remote (force since we amended)
puts ">>> Pushing to server..."
spawn git push deploy master --force
expect {
    "password:" { send "Rango2025=\r" }
    "Username" { send "root\r"; expect "password:"; send "Rango2025=\r" }
}
expect {
    -re "master -> master" { puts "\n>>> Push successful!" }
    -re "forced update" { puts "\n>>> Force push successful!" }
    eof
}
wait

puts "\n>>> Now building on server..."

# Step 2: SSH and build
spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
}
expect "# "

send "cd /opt/trace-system/trace-backend && wc -l src/main/java/com/huace/trace/service/CertTypeService.java src/main/java/com/huace/trace/service/DashboardService.java\r"
expect "# "

# Stop service
send "systemctl stop trace-backend\r"
expect "# "

# Build with Java 17
send "JAVA_HOME=/usr/lib/jvm/java-17-openjdk mvn package -DskipTests 2>&1 | tail -15\r"
expect {
    -re "BUILD SUCCESS" { puts "\n>>> BUILD SUCCESS!" }
    -re "BUILD FAILURE" {
        puts "\n>>> BUILD FAILURE!"
        expect "# "
        send "JAVA_HOME=/usr/lib/jvm/java-17-openjdk mvn package -DskipTests 2>&1 | grep -E 'ERROR' | head -15\r"
        expect "# "
    }
    timeout { puts "\n>>> Build timeout" }
}

expect "# "

# Start service
send "systemctl start trace-backend && sleep 8 && systemctl is-active trace-backend\r"
expect "# "

# Quick test - login
send "TOKEN=$(curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"test_enterprise\",\"password\":\"test123\",\"loginType\":\"enterprise\"}' 2>&1 | grep -o '\"token\":\"[^\"]*\"' | cut -d'\"' -f4) && echo TOKEN=$TOKEN\r"
expect "# "

# Test test-reports
send "curl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/test-reports 2>&1\r"
expect "# "

# Test batches
send "curl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/batches 2>&1\r"
expect "# "

send "exit\r"
expect eof

puts "\n>>> Deploy complete!"
