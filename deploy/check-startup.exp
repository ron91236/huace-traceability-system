#!/usr/bin/expect -f
set timeout 120

spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect "password:"
send "Rango2025=\r"
expect "# "

# Wait longer for Spring Boot to start
send "echo 'Waiting 30s for startup...' && sleep 30\r"
expect "# "

send "echo '=== Status ===' && systemctl is-active trace-backend\r"
expect "# "

send "echo '=== Port ===' && ss -tlnp | grep 8080\r"
expect "# "

send "echo '=== Java ===' && ps aux | grep java | grep -v grep | head -2\r"
expect "# "

send "echo '=== Recent logs ===' && journalctl -u trace-backend --no-pager -n 20 --since '5 min ago'\r"
expect "# "

send "exit\r"
expect eof
