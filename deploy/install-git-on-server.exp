#!/usr/bin/expect -f
# =========================================
# 在服务器上安装 Git 并重新配置
# =========================================

set timeout 60
set server_ip "8.152.162.118"
set password "Rango2025="

puts "========================================"
puts "  在服务器上安装 Git"
puts "========================================"

spawn ssh root@$server_ip
expect {
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "❌ SSH 连接超时"
        exit 1
    }
}

expect "#"

# 安装 Git
puts "\n正在安装 Git..."
send "yum install -y git\r"

expect {
    "#" {
        puts "✅ Git 安装完成"
    }
    "Is this ok" {
        send "y\r"
        exp_continue
    }
    timeout {
        puts "⚠️  安装时间较长，继续等待..."
        expect -timeout 120 "#"
    }
}

# 验证 Git 安装
send "git --version\r"
expect "#"

# 重新执行配置脚本
puts "\n重新执行配置脚本..."
send "/tmp/setup-git-hook.sh\r"

expect {
    "Git Hook 配置完成" {
        puts "✅ 配置成功"
    }
    timeout {
        puts "⚠️  脚本执行中..."
        expect -timeout 300 "#"
    }
}

send "exit\r"
expect eof

puts "\n========================================"
puts "  ✅ Git 安装和配置完成！"
puts "========================================"
