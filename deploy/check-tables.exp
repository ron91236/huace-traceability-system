#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 查看所有表
send "mysql -u root -p'root' trace_system -e \"SHOW TABLES;\"\r"
expect "#"

# 查看 V1__init_schema.sql 中的表定义
send "grep -i 'CREATE TABLE.*base\\|CREATE TABLE.*goods\\|CREATE TABLE.*batch' /opt/trace-system/sql/V1__init_schema.sql | head -10\r"
expect "#"

send "exit\r"
expect eof
