#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 创建目标目录
send "mkdir -p /opt/trace-system/trace-backend/target\r"
expect "#"

# 复制旧的 jar 包到正确位置
send "cp /opt/trace-backend/target/trace-backend-1.0.0.jar /opt/trace-system/trace-backend/target/\r"
expect "#"

# 验证复制成功
send "ls -lh /opt/trace-system/trace-backend/target/*.jar\r"
expect "#"

# 重启后端服务
send "systemctl restart trace-backend\r"
expect "#"

# 等待服务启动
send "sleep 10\r"
expect "#"

# 检查服务状态
send "systemctl status trace-backend --no-pager | grep -A 5 'Active:'\r"
expect "#"

# 测试 API
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}' 2>&1\r"
expect "#"

send "exit\r"
expect eof

puts "\n✅ 后端服务已修复！"
