#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 创建 Nginx 配置文件
send "cat > /etc/nginx/conf.d/trace.conf << 'NGINXCONF'\nserver {\n    listen 80;\n    server_name _;\n\n    root /opt/trace-system/trace-frontend/dist;\n    index index.html;\n\n    location / {\n        try_files \$uri \$uri/ /index.html;\n    }\n\n    location /api/ {\n        proxy_pass http://127.0.0.1:8080;\n        proxy_set_header Host \$host;\n        proxy_set_header X-Real-IP \$remote_addr;\n        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto \$scheme;\n        client_max_body_size 50m;\n    }\n\n    location /uploads/ {\n        alias /data/trace/uploads/;\n    }\n\n    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)\$ {\n        expires 30d;\n        add_header Cache-Control \"public, immutable\";\n    }\n\n    gzip on;\n    gzip_types text/plain text/css application/json application/javascript text/xml;\n    gzip_min_length 1024;\n}\nNGINXCONF\n\r"
expect "#"

# 测试配置
send "nginx -t 2>&1\r"
expect "#"

# 重启 Nginx
send "systemctl restart nginx\r"
expect "#"

# 验证服务状态
send "systemctl status nginx --no-pager | head -10\r"
expect "#"

# 测试 API
send "echo 'Testing API...'\r"
expect "#"
send "curl -s http://localhost/api/enterprise/test-reports/all 2>&1 | head -5\r"
expect "#"

send "exit\r"
expect eof
