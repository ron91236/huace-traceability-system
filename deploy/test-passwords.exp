#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 尝试多种可能的密码组合
send "echo 'Testing admin/admin123...'\r"
expect "#"
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "\necho 'Testing admin/Admin123456...'\r"
expect "#"
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"Admin123456\"}'\r"
expect "#"

send "\necho 'Testing test/test123...'\r"
expect "#"
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"test\",\"password\":\"test123\"}'\r"
expect "#"

# 查看后端日志中的认证错误详情
send "journalctl -u trace-backend -n 20 --no-pager | grep -i 'auth\\|login\\|password' || echo 'No auth errors found'\r"
expect "#"

send "exit\r"
expect eof
