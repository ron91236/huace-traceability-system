#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect "password:" { send "$password\r" }
expect "#"

send "echo '=== 后端服务状态 ===' && systemctl status trace-backend --no-pager | head -15\r"
expect "#"

send "echo '=== Nginx 状态 ===' && systemctl status nginx --no-pager | head -10\r"
expect "#"

send "echo '=== 前端文件 ===' && ls -lh /opt/trace-system/trace-frontend/dist/ 2>&1 | head -5\r"
expect "#"

send "echo '=== MySQL 状态 ===' && systemctl status mysqld --no-pager | head -10\r"
expect "#"

send "exit\r"
expect eof
