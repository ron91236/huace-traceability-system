#!/usr/bin/expect -f
set timeout 600

# Upload the 5 fixed files via scp
set files {
    "trace-backend/src/main/java/com/huace/trace/service/ProductService.java"
    "trace-backend/src/main/java/com/huace/trace/service/LabelSpecService.java"
    "trace-backend/src/main/java/com/huace/trace/service/CertTypeService.java"
    "trace-backend/src/main/java/com/huace/trace/service/DashboardService.java"
    "trace-backend/src/main/java/com/huace/trace/controller/TracePageController.java"
}

foreach f $files {
    puts ">>> Uploading $f ..."
    spawn scp -o StrictHostKeyChecking=no $f root@8.152.162.118:/opt/trace-system/$f
    expect {
        "password:" { send "Rango2025=\r" }
    }
    expect eof
    wait
}

puts "\n>>> All files uploaded. Now building on server..."

# SSH to server and build
spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
}
expect "# "

# Stop service
send "systemctl stop trace-backend\r"
expect "# "
puts ">>> Service stopped"

# Build
send "cd /opt/trace-system/trace-backend && mvn package -DskipTests 2>&1 | tail -30\r"
expect {
    -re "BUILD SUCCESS" {
        puts "\n>>> BUILD SUCCESS!"
    }
    -re "BUILD FAILURE" {
        puts "\n>>> BUILD FAILURE - checking errors..."
        expect "# "
        send "mvn package -DskipTests 2>&1 | grep 'ERROR' | head -20\r"
        expect "# "
    }
    timeout {
        puts "\n>>> Build timed out (took too long)"
    }
}

expect "# "

# Start service
send "systemctl start trace-backend\r"
expect "# "
puts ">>> Service started"

# Wait for startup
send "sleep 8\r"
expect "# "

# Check service status
send "systemctl is-active trace-backend\r"
expect "# "

# Test test-reports API
send "curl -s http://127.0.0.1:8080/api/enterprise/test-reports 2>&1\r"
expect "# "

# Test batches API
send "curl -s http://127.0.0.1:8080/api/enterprise/batches 2>&1\r"
expect "# "

send "exit\r"
expect eof

puts "\n>>> Deploy complete!"
