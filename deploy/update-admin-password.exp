#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 更新 admin 用户的密码为正确的 BCrypt 哈希
send "mysql -u root -p'root' trace_system -e \"UPDATE enterprise SET login_password_hash='\$2b\$10\$MKCpT2hj0K/1j4.8WKliXufYyCP/97.Wy0UURoJXiDUnjlZ9mVYja' WHERE login_account='admin';\"\r"
expect "#"

# 验证更新
send "mysql -u root -p'root' trace_system -e \"SELECT id, login_account, SUBSTRING(login_password_hash, 1, 20) as hash_preview FROM enterprise WHERE login_account='admin';\"\r"
expect "#"

# 测试登录
send "echo 'Testing login with admin/admin123...'\r"
expect "#"
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "\necho 'Login test completed!'\r"
expect "#"

send "exit\r"
expect eof
