#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 测试 admin/admin 登录
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin\"}'\r"
expect "#"

# 查看数据库中的用户信息
send "mysql -u root -p'Trace@2024' trace_system -e \"SELECT id, username, role FROM sys_user LIMIT 5;\"\r"
expect "#"

send "exit\r"
expect eof
