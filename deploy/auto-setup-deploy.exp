#!/usr/bin/expect -f
# =========================================
# 自动配置 Git Hook 部署脚本
# =========================================

set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="
set local_script "/Users/ron/Qoder/trace-system/deploy/setup-git-hook.sh"
set remote_script "/tmp/setup-git-hook.sh"

puts "========================================"
puts "  开始自动配置 Git Hook 部署"
puts "========================================"

# ---------- 步骤 1: 上传脚本到服务器 ----------
puts "\n步骤 1/4: 上传配置脚本到服务器..."
spawn scp $local_script root@$server_ip:$remote_script
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts "✅ 脚本上传成功"
    }
    timeout {
        puts "❌ 上传超时，请检查网络连接"
        exit 1
    }
}

# ---------- 步骤 2: SSH 登录并执行配置脚本 ----------
puts "\n步骤 2/4: 在服务器上执行配置脚本..."
spawn ssh root@$server_ip
expect {
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "❌ SSH 连接超时"
        exit 1
    }
}

expect "#"
send "chmod +x $remote_script\r"
expect "#"
send "$remote_script\r"

# 等待脚本执行完成（可能需要较长时间）
expect {
    "Git Hook 配置完成" {
        puts "✅ 配置脚本执行成功"
    }
    timeout {
        puts "⚠️  脚本执行时间较长，继续等待..."
        expect -timeout 300 "#"
    }
}

send "exit\r"
expect eof

# ---------- 步骤 3: 添加 deploy 远程仓库 ----------
puts "\n步骤 3/4: 添加 deploy 远程仓库..."
cd /Users/ron/Qoder/trace-system

# 检查是否已存在 deploy 远程
set result [exec git remote -v 2>&1]
if {[string match "*deploy*" $result]} {
    puts "⚠️  deploy 远程已存在，先删除"
    exec git remote remove deploy
}

exec git remote add deploy root@$server_ip:/opt/git-repos/trace-system.git
puts "✅ deploy 远程仓库添加成功"

# ---------- 步骤 4: 验证远程仓库 ----------
puts "\n步骤 4/4: 验证远程仓库配置..."
set remotes [exec git remote -v]
puts $remotes

puts "\n========================================"
puts "  ✅ Git Hook 自动部署配置完成！"
puts "========================================"
puts ""
puts "下一步：测试自动部署"
puts "  cd /Users/ron/Qoder/trace-system"
puts "  git push deploy master"
puts ""
puts "========================================"
