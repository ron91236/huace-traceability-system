#!/usr/bin/expect -f
set timeout 60
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 检查 enterprise 表中是否有 admin 用户
send "mysql -u root -p'root' trace_system -e \"SELECT id, login_account, name FROM enterprise WHERE login_account='admin';\"\r"
expect "#"

# 如果没有 admin 用户，创建一个新的
send "mysql -u root -p'root' trace_system << 'EOF'
-- 生成 admin123 的 BCrypt 密码哈希（使用 Spring Security 的默认强度）
-- 注意：这里需要使用应用生成的哈希，我们先用一个已知的测试哈希
INSERT INTO enterprise (login_account, login_password_hash, name, nature, industry, contact, phone, account_type, status) 
VALUES ('admin', '\$2a\$10\$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy', '华测检测认证集团', 'enterprise', 'testing', 'Admin', '13800138000', 'admin', 1)
ON DUPLICATE KEY UPDATE login_password_hash='\$2a\$10\$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy';
EOF
\r"
expect "#"

# 验证用户已创建
send "mysql -u root -p'root' trace_system -e \"SELECT id, login_account, name FROM enterprise WHERE login_account='admin';\"\r"
expect "#"

# 测试登录
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "exit\r"
expect eof
