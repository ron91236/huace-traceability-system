#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 查找所有 jar 包
send "find /opt -name '*.jar' 2>/dev/null | head -10\r"
expect "#"

# 检查是否有备份目录
send "ls -la /opt/trace-system/trace-backend/ | grep -E 'backup|old|bak'\r"
expect "#"

# 查看 systemd 服务配置中的 jar 路径
send "cat /etc/systemd/system/trace-backend.service | grep ExecStart\r"
expect "#"

send "exit\r"
expect eof
