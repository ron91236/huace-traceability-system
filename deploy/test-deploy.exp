#!/usr/bin/expect -f
# =========================================
# 测试推送到服务器触发自动部署
# =========================================

set timeout 600
set server_ip "8.152.162.118"
set password "Rango2025="

puts "========================================"
puts "  测试 Git Hook 自动部署"
puts "========================================"

cd /Users/ron/Qoder/trace-system

# 创建测试文件
puts "\n创建测试文件..."
exec echo "# Git Hook 自动部署测试 - [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}]" >> DEPLOY_TEST.md
exec git add DEPLOY_TEST.md
exec git commit -m "test: 测试 Git Hook 自动部署功能"

puts "\n推送到服务器（会触发自动部署）..."
spawn git push deploy master
expect {
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "❌ 推送超时"
        exit 1
    }
}

# 等待部署完成
expect {
    "部署完成" {
        puts "✅ 自动部署成功！"
    }
    "后端服务运行正常" {
        puts "✅ 服务检查通过！"
    }
    timeout {
        puts "⚠️  部署时间较长，继续等待..."
        expect -timeout 300 eof
    }
    eof {
        puts "推送完成"
    }
}

puts "\n========================================"
puts "  ✅ 测试完成！"
puts "========================================"
puts ""
puts "请访问以下地址验证部署："
puts "  前端: http://8.152.162.118"
puts "  API:  http://8.152.162.118/api/auth/login"
puts ""
puts "========================================"
