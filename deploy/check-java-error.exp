#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 查看最新的错误日志
send "journalctl -u trace-backend -n 50 --no-pager | grep -A 10 'Exception\\|Error\\|Failed'\r"
expect "#"

# 手动运行 jar 包看详细错误
send "cd /opt/trace-system/trace-backend && /usr/bin/java -jar target/trace-backend-1.0.0.jar --spring.profiles.active=prod 2>&1 | head -100 &\r"
expect "#"

send "sleep 5\r"
expect "#"

# 检查进程是否运行
send "ps aux | grep java | grep trace-backend | grep -v grep\r"
expect "#"

send "exit\r"
expect eof
