#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 尝试不同的 MySQL 密码
send "mysql -u root -e \"SELECT VERSION();\" 2>&1 | head -3\r"
expect "#"

send "mysql -u root -p'Trace@2024' -e \"SELECT VERSION();\" 2>&1 | head -3\r"
expect "#"

send "mysql -u root -p'root' -e \"SELECT VERSION();\" 2>&1 | head -3\r"
expect "#"

send "mysql -u root -p'' -e \"SELECT VERSION();\" 2>&1 | head -3\r"
expect "#"

# 查看 MySQL 配置文件
send "cat /etc/my.cnf 2>/dev/null | grep -i password || echo 'No password in my.cnf'\r"
expect "#"

# 查看是否有 .my.cnf 文件
send "cat ~/.my.cnf 2>/dev/null || echo 'No .my.cnf found'\r"
expect "#"

send "exit\r"
expect eof
