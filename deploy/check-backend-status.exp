#!/usr/bin/expect -f
set timeout 60
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 检查后端服务状态
send "systemctl status trace-backend --no-pager | head -30\r"
expect "#"

# 查看最新的错误日志
send "journalctl -u trace-backend -n 50 --no-pager | tail -50\r"
expect "#"

# 检查 jar 包是否存在
send "ls -lh /opt/trace-system/trace-backend/target/*.jar 2>&1 || echo 'No jar found'\r"
expect "#"

# 手动测试 API
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "exit\r"
expect eof
