#!/usr/bin/expect -f
set timeout 120

# SCP service file
spawn scp -o StrictHostKeyChecking=no /Users/ron/Qoder/trace-system/deploy/trace-backend.service root@8.152.162.118:/etc/systemd/system/trace-backend.service
expect "password:"
send "Rango2025=\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect "password:"
send "Rango2025=\r"
expect "# "

# Check current running process logs (the one on port 8080)
send "echo '=== Current process error logs ===' && journalctl -u trace-backend --no-pager -n 30 --since '10 min ago' 2>&1 | grep -i 'error\\|exception\\|fail\\|started\\|Tomcat' | tail -20\r"
expect "# "

# Restart with fixed service
send "systemctl daemon-reload && systemctl restart trace-backend\r"
expect "# "

send "echo 'Waiting 40s for full startup...' && sleep 40\r"
expect "# "

send "echo '=== Status ===' && systemctl is-active trace-backend && echo '=== Port ===' && ss -tlnp | grep 8080\r"
expect "# "

# Test login with raw output
send "echo '=== Login test ===' && curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\",\"loginType\":\"admin\"}'\r"
expect "# "

send "echo ''\r"
expect "# "

# Check startup logs for new process
send "echo '=== Startup logs ===' && journalctl -u trace-backend --no-pager -n 15 --since '1 min ago' 2>&1 | grep -i 'started\\|error\\|Tomcat\\|exception' | tail -10\r"
expect "# "

send "exit\r"
expect eof
