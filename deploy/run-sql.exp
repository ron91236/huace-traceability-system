#!/usr/bin/expect -f
set timeout 120

spawn ssh root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
    timeout { puts "SSH连接超时"; exit 1 }
}

expect "# "

# Wait longer for backend startup
send "sleep 30\r"
expect "# "

# Check status
send "curl -s -o /dev/null -w 'HTTP %{http_code}' http://127.0.0.1:8080/api/auth/login && echo\r"
expect "# "

# Check recent logs
send "journalctl -u trace-backend --no-pager -n 30 --since '2 min ago' 2>&1 | tail -30\r"
expect "# "

send "exit\r"
expect eof
