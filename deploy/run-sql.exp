#!/usr/bin/expect -f
set timeout 30

spawn ssh root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
    timeout { puts "SSH超时"; exit 1 }
}

expect "# "

# Check password hashes
send "mysql -u root -proot trace_system -e \"SELECT id, login_account, LEFT(login_password_hash, 30) as pwd_hash FROM enterprise WHERE login_account IN ('aliceshi','mu','test_enterprise','farm_001')\" 2>/dev/null | grep -v Warning\r"
expect "# "

# Set password for test_enterprise to admin123 BCrypt hash
send "mysql -u root -proot trace_system -e \"UPDATE enterprise SET login_password_hash = '\$2a\$10\$MKCpT2hj0K/1j4.8WKliXufYyCP/97.Wy0UURoJXiDUnjlZ9mVYja' WHERE login_account = 'test_enterprise'\" 2>/dev/null && echo 'PWD SET OK'\r"
expect "# "

send "exit\r"
expect eof
