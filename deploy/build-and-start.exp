#!/usr/bin/expect -f
set timeout 600

spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
}
expect "# "

# Set JAVA_HOME
send "export JAVA_HOME=/usr/lib/jvm/java-17-openjdk\r"
expect "# "

# Verify java version
send "java -version 2>&1\r"
expect "# "

# Build with correct JAVA_HOME
send "cd /opt/trace-system/trace-backend && JAVA_HOME=/usr/lib/jvm/java-17-openjdk mvn package -DskipTests 2>&1 | tail -20\r"
expect {
    -re "BUILD SUCCESS" {
        puts "\n>>> BUILD SUCCESS!"
    }
    -re "BUILD FAILURE" {
        puts "\n>>> BUILD FAILURE"
        expect "# "
        send "JAVA_HOME=/usr/lib/jvm/java-17-openjdk mvn package -DskipTests 2>&1 | grep -E 'ERROR|error' | head -20\r"
        expect "# "
    }
    timeout {
        puts "\n>>> Build timed out"
    }
}

expect "# "

# Start service
send "systemctl start trace-backend\r"
expect "# "

# Wait for startup
send "sleep 8\r"
expect "# "

# Check status
send "systemctl is-active trace-backend\r"
expect "# "

# Login to get token
send "curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"test_enterprise\",\"password\":\"test123\",\"loginType\":\"enterprise\"}' 2>&1\r"
expect "# "

# Test test-reports
send "curl -s http://127.0.0.1:8080/api/enterprise/test-reports 2>&1\r"
expect "# "

# Test batches
send "curl -s http://127.0.0.1:8080/api/enterprise/batches 2>&1\r"
expect "# "

send "exit\r"
expect eof
