#!/usr/bin/expect -f
set timeout 120

spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect {
    "password:" { send "Rango2025=\r" }
}
expect "# "

# Fix post-receive hook - add JAVA_HOME
send "sed -i '2a export JAVA_HOME=/usr/lib/jvm/java-17-openjdk' /opt/git-repos/trace-system.git/hooks/post-receive\r"
expect "# "

send "head -4 /opt/git-repos/trace-system.git/hooks/post-receive\r"
expect "# "

# Test APIs using a script
send "cat > /tmp/test.sh << 'SCRIPT'\n#!/bin/bash\nTOKEN=$(curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"test_enterprise\",\"password\":\"test123\",\"loginType\":\"enterprise\"}' | python3 -c 'import sys,json; print(json.load(sys.stdin).get(\"data\",{}).get(\"token\",\"\"))')\necho TOKEN_LEN=${#TOKEN}\necho '--- test-reports ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/test-reports | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- batches ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/batches | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- goods ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/goods | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- bases ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/bases | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- orders ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/orders | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- dashboard ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/dashboard | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"data:\",list(d.get(\"data\",{}).keys()))'\necho '--- cert-types ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/cert-types | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- label-specs ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/label-specs | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- products ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/products | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- notices ---'\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8080/api/enterprise/notices | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code:\",d.get(\"code\"),\"msg:\",d.get(\"msg\"))'\necho '--- nginx proxy ---'\ncurl -s -o /dev/null -w 'HTTP %{http_code}' http://8.152.162.118/\nSCRIPT\r"
expect "# "

send "bash /tmp/test.sh\r"
expect "# "

send "exit\r"
expect eof
