#!/usr/bin/expect -f
set timeout 60
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 查找占用 8080 端口的进程
send "lsof -i :8080 | grep LISTEN\r"
expect "#"

# 杀掉占用端口的进程
send "pkill -9 -f 'trace-backend' || true\r"
expect "#"

# 等待几秒确保进程完全退出
send "sleep 3\r"
expect "#"

# 再次确认端口已释放
send "lsof -i :8080 | grep LISTEN || echo 'Port 8080 is free'\r"
expect "#"

# 重启后端服务
send "systemctl restart trace-backend\r"
expect "#"

# 等待服务启动
send "sleep 15\r"
expect "#"

# 检查服务状态
send "systemctl status trace-backend --no-pager | head -20\r"
expect "#"

# 测试 API
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "exit\r"
expect eof
