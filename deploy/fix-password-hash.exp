#!/usr/bin/expect -f
set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

spawn ssh root@$server_ip
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$password\r" }
}

expect "#"

# 使用正确的 BCrypt 哈希（完整的 $2a$10$... 格式）
# 这个哈希是通过 Python bcrypt 库生成的 admin123 的哈希
send "mysql -u root -p'root' trace_system << 'SQLEOF'\nUPDATE enterprise SET login_password_hash='\$2a\$10\$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy' WHERE login_account='admin';\nSQLEOF\n\r"
expect "#"

# 验证哈希已正确保存
send "mysql -u root -p'root' trace_system -e \"SELECT login_password_hash FROM enterprise WHERE login_account='admin';\"\r"
expect "#"

# 测试登录
send "curl -s http://localhost:8080/api/auth/login -X POST -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'\r"
expect "#"

send "exit\r"
expect eof
