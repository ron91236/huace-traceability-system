#!/usr/bin/expect -f
set timeout 60

# SCP service file
spawn scp -o StrictHostKeyChecking=no /Users/ron/Qoder/trace-system/deploy/trace-backend.service root@8.152.162.118:/etc/systemd/system/trace-backend.service
expect "password:"
send "Rango2025=\r"
expect eof

# SSH to restart
spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect "password:"
send "Rango2025=\r"
expect "# "

send "systemctl daemon-reload\r"
expect "# "

send "systemctl restart trace-backend\r"
expect "# "

# Wait for startup
send "sleep 15 && systemctl is-active trace-backend\r"
expect "# "

send "ss -tlnp | grep 8080\r"
expect "# "

# Quick test login
send "curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\",\"loginType\":\"admin\"}' | head -200\r"
expect "# "

send "exit\r"
expect eof
