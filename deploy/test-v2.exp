#!/usr/bin/expect -f
set timeout 60

spawn ssh -o StrictHostKeyChecking=no root@8.152.162.118
expect "password:"
send "Rango2025=\r"
expect "# "

# Get admin token
send "ADMIN_TOKEN=\$(curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\",\"loginType\":\"admin\"}' | python3 -c 'import sys,json; print(json.load(sys.stdin)\[\"data\"\]\[\"token\"\])')\r"
expect "# "

# DB structure check
send "mysql -u root -proot trace_system -e 'DESCRIBE enterprise;' 2>&1 | head -20\r"
expect "# "

send "mysql -u root -proot trace_system -e 'DESCRIBE sys_user;' 2>&1 | head -15\r"
expect "# "

send "mysql -u root -proot trace_system -e 'SELECT id,login_account FROM enterprise LIMIT 10;' 2>&1\r"
expect "# "

send "mysql -u root -proot trace_system -e 'SELECT * FROM sys_user;' 2>&1\r"
expect "# "

# Admin APIs
send "echo '=== dashboard ===' && curl -s -H \"Authorization: Bearer \$ADMIN_TOKEN\" 'http://127.0.0.1:8080/api/admin/dashboard' | head -300\r"
expect "# "

send "echo '=== notices ===' && curl -s -H \"Authorization: Bearer \$ADMIN_TOKEN\" 'http://127.0.0.1:8080/api/admin/notices?page=1&size=10' | head -200\r"
expect "# "

# Try enterprise login with first enterprise account
send "echo '=== enterprise login ===' && curl -s -X POST http://127.0.0.1:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"test_enterprise\",\"password\":\"test123\",\"loginType\":\"enterprise\"}' | head -200\r"
expect "# "

send "echo ''\r"
expect "# "

# Public APIs
send "echo '=== templates ===' && curl -s 'http://127.0.0.1:8080/api/trace/templates' | head -200\r"
expect "# "

send "exit\r"
expect eof
