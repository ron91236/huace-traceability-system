#!/usr/bin/expect -f
# =========================================
# 检查服务器上服务状态
# =========================================

set timeout 30
set server_ip "8.152.162.118"
set password "Rango2025="

puts "========================================"
puts "  检查服务器服务状态"
puts "========================================"

spawn ssh root@$server_ip
expect {
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "❌ SSH 连接超时"
        exit 1
    }
}

expect "#"

# 检查后端服务状态
puts "\n[1] 检查后端服务状态..."
send "systemctl status trace-backend --no-pager | head -20\r"
expect "#"

# 检查 Nginx 状态
puts "\n[2] 检查 Nginx 状态..."
send "systemctl status nginx --no-pager | head -15\r"
expect "#"

# 检查前端文件是否存在
puts "\n[3] 检查前端构建文件..."
send "ls -lh /opt/trace-system/trace-frontend/dist/ 2>&1 | head -10\r"
expect "#"

# 查看后端日志（最近10行）
puts "\n[4] 查看后端最近日志..."
send "journalctl -u trace-backend -n 20 --no-pager\r"
expect "#"

# 检查数据库连接
puts "\n[5] 检查 MySQL 状态..."
send "systemctl status mysqld --no-pager | head -10\r"
expect "#"

send "exit\r"
expect eof

puts "\n========================================"
puts "  ✅ 检查完成"
puts "========================================"
